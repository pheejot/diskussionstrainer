# Vorlage fuer die App-Secrets in Streamlit Community Cloud.
# NICHT ins Repository hochladen. Die echten Werte werden in der Streamlit-
# Oberflaeche eingetragen: App -> Settings -> Secrets.

# Pflicht: der API-Schluessel. Eigener Schluessel bzw. eigenes OpenAI-Projekt
# fuer den Trainer, damit dessen Kosten getrennt sichtbar bleiben.
OPENAI_API_KEY = "sk-..."

# Code, den die Schueler beim Start eingeben. Steht auf der Rollenkarte.
# Leer lassen oder Zeile entfernen = kein Code noetig.
KLASSENCODE = "volksentscheid"

# Freigabefenster, Format JJJJ-MM-TT. Beide Zeilen sind optional:
# ohne FREIGABE_START ist der Trainer sofort offen,
# ohne FREIGABE_ENDE bleibt er dauerhaft offen.
FREIGABE_START = "2026-09-15"
FREIGABE_ENDE = "2026-09-17"
